# ---------------------------------------------------------------------------
# Face Attendance — environment configuration
# Copy to .env and adjust. Everything here has a safe default baked into
# backend/app/config.py, so `docker compose up` works even without a .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=face_attendance
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=face_attendance
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Async driver, used by the API at runtime
DATABASE_URL=postgresql+asyncpg://face_attendance:change_me_dev_only@db:5432/face_attendance
# Sync driver, used only by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://face_attendance:change_me_dev_only@db:5432/face_attendance

# --- Auth ---------------------------------------------------------------
JWT_SECRET=dev_only_change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Biometric data protection ---------------------------------------------
# 32-byte urlsafe-base64 Fernet key. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMBEDDING_ENCRYPTION_KEY=Uh6Z8s4y6b0e7z3v1c9x2q5w8n1m4k7j0h3g6f9d2s5=

# --- Kiosk service auth (POST /api/v1/kiosk/event) ---------------------------
KIOSK_SERVICE_TOKEN=dev_only_kiosk_service_token

# --- Kiosk runtime -----------------------------------------------------------
KIOSK_ID=kiosk-01
CAMERA_SOURCE= "0" #synthetic
# "synthetic" drives the kiosk from scripts/seed_demo.py generated faces when no
# real camera/RTSP url is available (see docs/DECISIONS.md). Set to a camera
# index ("0") or an rtsp:// URL for real hardware.
API_BASE_URL=http://api:8000
DEVICE_PREFERENCE=auto

# --- ONNX Runtime build flavor (see docker-compose.yml + README "Upgrading to GPU") ---
ORT_FLAVOR=cpu

# --- Frontend -----------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- Timezone -----------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata

# --- Model weights (auto-downloaded on first run, see docs/DECISIONS.md) ----
MODEL_CACHE_DIR=/models
INSIGHTFACE_MODEL_NAME=buffalo_l
