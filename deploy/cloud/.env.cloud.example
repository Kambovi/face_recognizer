# ---- SaaS cloud: copy to .env and fill EVERYTHING (docs/CLOUD_SETUP.md) ----
# Domain: dashboards at <client>.attendance.example.in
BASE_DOMAIN=attendance.example.in
ACME_EMAIL=you@example.in

# Postgres (only reachable inside the server)
POSTGRES_USER=fa_app
POSTGRES_PASSWORD=          # 32+ random chars: python -c "import secrets;print(secrets.token_urlsafe(32))"

# Secrets -- generate: cd backend && python scripts/gen_secrets.py   and   python -m app.licence keygen
JWT_SECRET=
EMBEDDING_ENCRYPTION_KEY=   # encrypts tenant DB URLs + API keys at rest in the cloud
LICENCE_PRIVATE_KEY=        # signs edge-box licences; never leaves this server

JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=
APP_TIMEZONE=Asia/Kolkata
